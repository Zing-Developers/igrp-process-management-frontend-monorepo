{
  "name": "@irn/platform-process-management-types",
  "version": "0.1.0-beta.22",
  "type": "module",
  "description": "IGRP Process Management Frontend | Types",
  "keywords": [
    "igrp",
    "process",
    "management",
    "frontend",
    "types"
  ],
  "author": "IGRP Team",
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "rimraf dist && rimraf tsconfig.tsbuildinfo && pnpm format && tsc -b",
    "format": "prettier --write \"src/**/*.ts\" package.json tsconfig.json",
    "release": "pnpm build && pnpm publish --registry=https://nexus-1.zingaistudio.com/repository/npm-repo/ --tag latest"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "next-auth": "^4.24.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.x.x"
  }
}
