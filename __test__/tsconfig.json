{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "../",
    "composite": true,
    "outDir": "./dist",
    "paths": {
      "@igrp/platform-process-management-client-ts": ["packages/client/src/index.ts"],
      "@igrp/platform-process-management-client-ts/*": ["packages/client/src/*"],
      "@igrp/platform-process-management-types": ["packages/types/src/index.ts"],
      "@igrp/platform-process-management-types/*": ["packages/types/src/*"]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.d.ts",
    "**/*.js"
  ],
  "references": [
    { "path": "../packages/types" },
    { "path": "../packages/client" }
  ]
}
